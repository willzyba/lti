# Copy this file to .env and fill in real values before running `npm start`.

# Required. A MongoDB connection string - ltijs' own platform/session store. Each platform
# gets its own RSA keypair, generated automatically when it is registered (see platforms.js)
# and stored here; there is no separate global encryption key to set for a fresh install.
# For local testing: mongodb://127.0.0.1:27017/eqneditor-lti
MONGO_URL=

# Port the server listens on, and this tool's public address as LMSs reach it.
PORT=3000
TOOL_URL=http://localhost:3000

# log (default): record each deployment's use and licence; enforce: an unlicensed deployment is
# shown how to get licensed instead of the editor. Licences are checked at FXTEX_ORIGIN.
LICENCE_MODE=log
FXTEX_ORIGIN=https://fxtex.codecogs.com

# Same meaning as every other adapter in this repo. EQNEDITOR_LICENCE is passed straight to
# EqEditor.init(): the fxTeX Pro licence for this tool's own address (every page is served from
# it, whichever institution launched). Blank, the editor shows a locked-converter message in
# place of the maths view.
EQNEDITOR_SERVER=fxtex.codecogs.com
EQNEDITOR_RENDER_URL=https://latex.codecogs.com
EQNEDITOR_SHOW_LATEX=false
EQNEDITOR_LICENCE=
# Or the path of a file holding it (a Docker secret, as docker-swarm/docker-fxlti.yml does).
# EQNEDITOR_LICENCE_FILE=

# Platform registrations: either point PLATFORMS_FILE at a JSON file shaped like
# platforms.example.json (the default, ./platforms.json, needs no env var at all), or set
# PLATFORMS_JSON to the same content directly, for a deployment that would rather keep
# platform registrations in a secret manager than a file on disk.
# PLATFORMS_FILE=./platforms.json
# PLATFORMS_JSON=
