# Copy this file to .env and fill in real values before running `npm start`.

# Required. A MongoDB connection string - ltijs' own platform/session store. Each platform
# gets its own RSA keypair, generated automatically when it is registered (see platforms.js)
# and stored here; there is no separate global encryption key to set for a fresh install.
# For local testing: mongodb://127.0.0.1:27017/eqneditor-lti
MONGO_URL=

# Port the server listens on.
PORT=3000

# Same meaning as every other adapter in this repo.
EQNEDITOR_SERVER=editor.codecogs.com
EQNEDITOR_RENDER_URL=https://latex.codecogs.com
EQNEDITOR_SHOW_LATEX=false

# Platform registrations: either point PLATFORMS_FILE at a JSON file shaped like
# platforms.example.json (the default, ./platforms.json, needs no env var at all), or set
# PLATFORMS_JSON to the same content directly, for a deployment that would rather keep
# platform registrations in a secret manager than a file on disk.
# PLATFORMS_FILE=./platforms.json
# PLATFORMS_JSON=
